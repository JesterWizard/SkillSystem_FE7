
#include "BattleCalcDefinitions.event"

	/* Pre-battle calculation loop */

PUSH
ORG 0x289b0 //FE7 -> FE8 0x2a95c
jumpToHack(BtlLoopParent)

POP

ALIGN 4
BtlLoopParent:
#incbin "FE7_battle_calc_loop.dmp"
POIN BtlLoopList

ALIGN 4
BtlLoopList:
POIN InitializePreBattleLoop
POIN BC_DefRes BC_Power BC_ASpd BC_Hit BC_Avo BC_Crit CritUpSkill BC_Dodge BC_Support BC_WRank BC_Status //these are the existing battle calculation routines
#ifdef LAST_HIT_CRIT
POIN LastHitCrit
#endif
POIN FaireCheck
POIN BreakerCheck MageSlayer
POIN BlowCheck
POIN DefendingCheck
POIN ElementBoostCheck
POIN Wrath
POIN LuckySeven OddRhythm EvenRhythm QuickBurn SlowBurn
POIN Loyalty
POIN DancingBlade
POIN ElbowRoom NaturalCover FieryBlood LifeAndDeath WindDisciple Perfectionist Puissance EyesOfHawk LightWeight Trample Opportunist BattleVeteran SilentPride Thunderstorm HeavyStrikes Charge Vanity KnightAspirant Outrider AssassinateDamageBonus ArcaneBlade
POIN Prescience
POIN Insight Vigilance DefiantAvo DefiantCrit TowerShield ShortShield IndoorFighter OutdoorFighter Deadeye Fortune ChaosStyle StunningSmile HeavyBlade
POIN BlueFlame DoubleLion Thighdeology Thotslayer ForeignPrincess ChargePlus HolyAura Cultured SteadyBrawler
POIN Frenzy
POIN KeenFighter
POIN TowerShieldPlus
POIN DragonSkin
POIN AxeFaith
POIN StancesASM
POIN AirRaidSkillCheck
POIN CriticalCheck
POIN LethalitySkill NonGBALethalitySkill
POIN Gamble
POIN Demoiselle Gentilhomme MaleficAura Intimidate Inspiration DivinelyInspiring Charm Charisma VoiceOfPeace Tantivy Focus Anathema Hex LilysPoise UpWithArch Solidarity Daunt BloodTide WhitePool NightTide Infiltrator Armorboost Horseguard Skyguard
POIN SpurStr SpurMag SpurSpd SpurDef SpurRes SpurSkl SpurLuk
POIN DriveStr DriveMag DriveSpd DriveDef DriveRes DriveSkl DriveLuk
#ifdef BIORHYTHM
POIN BiorhythmFunc
#endif
POIN 0

#define AuraSkillEntry(skillID) "PUSH; ORG AuraSkillTable + skillID; BYTE 0x1; POP"

ALIGN 4
AuraSkillTable:
FILL 256
AuraSkillEntry(NiceThighsID)
AuraSkillEntry(AmaterasuID)
AuraSkillEntry(BondID)
AuraSkillEntry(AnathemaID)
AuraSkillEntry(BloodTideID)
AuraSkillEntry(CharismaID)
AuraSkillEntry(CharmID)
AuraSkillEntry(DauntID)
AuraSkillEntry(DemoiselleID)
AuraSkillEntry(DivinelyInspiringID)
AuraSkillEntry(DriveStrID)
AuraSkillEntry(DriveMagID)
AuraSkillEntry(DriveSklID)
AuraSkillEntry(DriveSpdID)
AuraSkillEntry(DriveLukID)
AuraSkillEntry(DriveDefID)
AuraSkillEntry(DriveResID)
AuraSkillEntry(GentilhommeID)
AuraSkillEntry(HexID)
AuraSkillEntry(InspirationID)
AuraSkillEntry(IntimidateID)
AuraSkillEntry(LilysPoiseID)
AuraSkillEntry(MaleficAuraID)
AuraSkillEntry(NightTideID)
AuraSkillEntry(SolidarityID)
AuraSkillEntry(SpurStrID)
AuraSkillEntry(SpurMagID)
AuraSkillEntry(SpurSklID)
AuraSkillEntry(SpurSpdID)
AuraSkillEntry(SpurLukID)
AuraSkillEntry(SpurDefID)
AuraSkillEntry(SpurResID)
AuraSkillEntry(VoiceOfPeaceID)
AuraSkillEntry(WhitePoolID)
AuraSkillEntry(BlueFlameID)

PUSH
ORG 0x28484 //FE7 -> FE8 0x2a3f8
jumpToHack(rewriteRangeMap)
POP

ALIGN 4
rewriteRangeMap:
#incbin "rewriteRangeMap.dmp"

PROTECT 0x2A95C 0x2A968

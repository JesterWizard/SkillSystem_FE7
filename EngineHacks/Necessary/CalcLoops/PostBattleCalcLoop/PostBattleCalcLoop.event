
	/* Post-battle calculation loop*/

PUSH
ORG $34524 //FE8 -> $37748 // HandlePostActionTraps occurs before the hook at $1D308 and sets action to "wait" when standing on a trap 
jumpToHack(PostCombatLoop)
POP

PostCombatLoop:
#include "post_loop.lyn.event"

PostCombatSkills: //I like having savage blow as the first one because it makes the activation sound play first
POIN SavageBlow Despoil Lifetaker Fury BreathOfLife /*PoisonStrike GrislyWound*/
POIN Canto CantoPlus Gridmaster Galeforce FailGale ReMove Powerstaff CulturedPostCombat
#ifdef ENABLE_BUFF_SKILLS
POIN StrTaker SklTaker SpdTaker DefTaker ResTaker LukTaker MagTaker MovTaker
#endif
#ifdef SUPPORT_AFTER_BATTLE
POIN PostBattleSupports_Hook
#endif
WORD 0 //Terminator

PROTECT $1CC54 $1CC60
#ifndef MODULAR_STAT_SCREEN
#define MODULAR_STAT_SCREEN

// Modular Stat Screen.
// hack by circleseverywhere

// Skill System Stat Screen by circleseverywhere with additions by Tequila, and probably more people too

#ifdef _FE7_

  // Page 1 uses the Skill System Str/Mag layout (8 left-column rows).
  #define Skl_Arrow_X 0x78
  #define Skl_Arrow_Y 0x38
  #define Spd_Arrow_X 0x78
  #define Spd_Arrow_Y 0x48
  #define Trv_Icon_X 0xB8
  #ifdef ALTERNATE_SKILL_SUPPORT_PAGES
  #define Trv_Icon_Y 0x6E
  #else
  #define Trv_Icon_Y 0x2E
  #endif
  
  #include "DisplayGrowthsOptions/DisplayGrowthsOptions.event"
  #include "WeaponRankStatScreen/WeaponRankStatScreen.event"
  #include "Background/Background.event"
 
  PUSH
    // FE7 loads page routines from 08404B60 (see 080804D0).
    ORG 0x404B60  //FE8 -> 0x205b24
    #ifdef ALTERNATE_SKILL_SUPPORT_PAGES
      POIN MSS_page1|1 MSS_page2|1 MSS_page3|1 MSS_page4|1
    #else
      POIN MSS_page1|1 MSS_page2|1 MSS_page3|1
    #endif

    ORG $811BC //FE8 -> $88690
    #ifdef ALTERNATE_SKILL_SUPPORT_PAGES
      BYTE 4
    #else
      BYTE 3 // 3 pages
    #endif

    // Make all the arrows line up with the stats and stuff

    // Vanilla OBJ down-arrows at (Skl/Spd) while US_RESCUING. Savior skips
    // those two sprites but still draws the Trv rescuee icon.
    ORG $80F84
      jumpToHack(SkipRescueArrowsIfSavior)

    ORG $80F90 //FE8 -> $883C0
      BYTE Skl_Arrow_X 0x20 Skl_Arrow_Y

    ORG $80F9A //FE8 -> $883CA
      BYTE Spd_Arrow_X 0x20 Spd_Arrow_Y

    ORG $80FC8 //FE8 -> $883F6
      BYTE Trv_Icon_X 0x21 Trv_Icon_Y

      // Display growths hack
      // BYTE 0x82 → mov r0,#0x82; lsl #1 → mask 0x104 (R|Select).
      // Button_Branch then splits R (help) vs Select (toggle growths).

    #ifdef PRESS_SELECT_TO_VIEW_GROWTHS
      ORG $813E2 //FE8 -> $8888C
      BYTE 0x82
    #endif

    ORG $813EE //FE8 -> $88896
      SHORT 0x46C0
      jumpToHack(Button_Branch)

    #ifdef ALTERNATE_SKILL_SUPPORT_PAGES
    // Page 1's vanilla `beq $81526` lands inside jumpToHack's literal at $81520.
    // Send page 0 through HelpPageSelect instead; pages 1-2 keep the vanilla loads.
    ORG $81516
      SHORT $D003
    ORG $81520
      jumpToHack(MSS_HelpPageSelect)
    #endif

    // Remember whether we were looking at growths or stats

    ORG $814AC //FE8 -> $8895C //Loads byte to store 1 before stat screen struct
      callHack_r1(Load_Page)

    ORG $81414 //FE8 -> $888BC //Stores byte to store 1 before stat screen struct
      callHack_r3(Store_Page)

    ORG $7FA8C //FE8 -> $86E44
  jumpToHack(MSS_leftpage)

    // DrawBar (0x0807FD28) calls this for the small +/- next to each stat.
    // Vanilla 0x08006240 can only print a green '+'; negatives become '+7'.
    ORG $6240
      jumpToHack(DrawSignedBonusNumber)

  POP
  
  ALIGN 4
  TalkTextIDLink:
  SHORT SS_TalkText
  ALIGN 4
  SkillsTextIDLink:
  SHORT SS_SkillsText
  ALIGN 4
  AffinTextIDLink:
  SHORT SS_AffinText
  ALIGN 4
  AlternatePagesLink:
  #ifdef ALTERNATE_SKILL_SUPPORT_PAGES
  SHORT 1
  #else
  SHORT 0
  #endif
  ALIGN 4
  Display_Growth_Options_Link:
  WORD Growth_Options

  #ifdef ALTERNATE_SKILL_SUPPORT_PAGES
  ALIGN 4
  WeaponSkillsTextIDLink:
  SHORT SS_WeaponSkillsText
  ALIGN 4
  SupportLevelTextIDLink:
  SHORT SS_SupportLevelText
  ALIGN 4
  BonusTextIDLink:
  SHORT SS_BonusText
  ALIGN 4
  AtkShortTextIDLink:
  SHORT SS_AtkShortText
  ALIGN 4
  HitShortTextIDLink:
  SHORT SS_HitShortText
  ALIGN 4
  AvoidTextIDLink:
  SHORT SS_AvoidText
  ALIGN 4
  CritShortTextIDLink:
  SHORT SS_CritShortText
  ALIGN 4
  DdgTextIDLink:
  SHORT SS_DdgText
  #endif

  #include "pages/AdjustBarBaseForSavior.lyn.event"
  #include "pages/SkipRescueArrowsIfSavior.lyn.event"
  POIN SkillTester
  WORD SaviorID
  #include "pages/signed_bonus_number.lyn.event"
  #include "pages/mss_page1_skills.lyn.event"
  #include "pages/mss_page2_original.lyn.event"
  #ifdef ALTERNATE_SKILL_SUPPORT_PAGES
  #include "pages/mss_page3_weapons_skills.lyn.event"
  #include "pages/mss_page4_supports.lyn.event"
  #else
  #include "pages/mss_page3_original.lyn.event"
  #endif
  #include "pages/mss_leftstatscreen.lyn.event"
  POIN (IdentityNameId|1)
  
  ALIGN 4
  DontBlinkLeft:
  #incbin "asm/DontBlinkLeft.dmp"

  ALIGN 4
  Button_Branch:
    #incbin "asm/ButtonBranch.dmp"

  ALIGN 4
  Load_Page:
    #incbin "asm/LoadPage.dmp"
    WORD Stat_Page_Ram_Loc

  ALIGN 4
  Store_Page:
    #incbin "asm/StorePage.dmp"
    WORD Stat_Page_Ram_Loc

  ALIGN 4
  Get_Palette_Index:
    #incbin "asm/Get_Palette_Index.dmp"
    POIN Growth_Color_Table

  ALIGN 4
  HP_Name_Color:
    #incbin "asm/HPNameColor.dmp"
    POIN New_Palettes
    WORD Growth_Options
    POIN Get_Hp_Growth
    POIN Get_Palette_Index

  ALIGN 4
  Growth_Color_Table:
    #include "DisplayGrowthsOptions/GrowthColorsTable.event"

  ALIGN 4
  New_Palettes:
    #include "DisplayGrowthsOptions/NewPalette.event"

  #include "RText.event"

#else // _FE7_
  ERROR Modular Stat Screen hack is for FE7
#endif // _FE7_

#endif // MODULAR_STAT_SCREEN

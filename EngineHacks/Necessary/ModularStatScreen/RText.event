  /*

  stat screen R menu is at 8a00b38
  find by breaking on key press while R menu open

  Each entry is 6 words
  Pointer 1 (up)
  POinter 2 (down)
  POinter 3 (left)
  Pointer 4 (right)
  x,y,Txtid
  Zero
  (Optional Pointer for alternate text routine)

  ST_Name:
  WORD 0
  POIN ST_Class
  WORD 0
  POIN ST_Luck
  BYTE 0x18
  BYTE 0x50
  SHORT 0
  WORD 0

  */

  #include "EAstdlib.event"

  // Vanilla FE7U help IDs from the stat-screen R-menu at 0x08CC2140.
  // Right column is Mov/Con/Aid/Trv/Affin, not FE8's Con/Aid first.
  // FE8 0x54x/0x55x/0x6E8 IDs are names and class descs here, not help.
  #define HTID_Class 0x22B
  #define HTID_Level 0x25B
  #define HTID_Exp   0x25C
  #define HTID_HP    0x25D
  #define HTID_Atk   0x25F
  #define HTID_Hit   0x260
  #define HTID_Rng   0x261
  #define HTID_Crit  0x262
  #define HTID_Avo   0x263
  #define HTID_Str   0x264
  #define HTID_Mag   0x265
  #define HTID_Skl   0x266
  #define HTID_Spd   0x267
  #define HTID_Def   0x268
  #define HTID_Res   0x269
  #define HTID_Con   0x26A
  #define HTID_Aid   0x26B
  #define HTID_Mov   0x26C
  #define HTID_Trv   0x26D
  #define HTID_Luck  0x26E
  #define HTID_Affin 0x26F
  #define HTID_Supports 0x350

  #include "RTextGetters/RTextGetters.event"

  #define RMenu(up,down,left,right,xcoord,ycoord,TID) "POIN up down left right;BYTE xcoord ycoord; SHORT TID; WORD 0 0;"
  #define RMenu(up,down,left,right,xcoord,ycoord,TID,Getter) "POIN up down left right; BYTE xcoord ycoord; SHORT TID; POIN 0 Getter|1"
  #define RMenu(up,down,left,right,xcoord,ycoord,SlotID,Looper,Getter) "POIN up down left right; BYTE xcoord ycoord; SHORT SlotID; POIN Looper|1 Getter|1"
  #define RMenu_Cond(up,down,left,right,xcoord,ycoord,TID,Conditional) "POIN up down left right; BYTE xcoord ycoord; SHORT TID; POIN Conditional|1 0"

  #define NameDescGetter 0x816FD //FE8 -> 0x88bd5 I'm concerned that the function in FE7 doesn't being with a push opcode. I'm hoping it isn't an issue
  #define ClassDescGetter 0x81725 //FE8 -> 0x88c01
  #define ConditionGetter 0x81581 //FE8 -> 0x88a2d
  #define StrMagGetter 0x81635 //FE8 -> 0x88b09
  #define ItemDescGetter 0x81555 //FE8 -> 0x88A01
  #define ItemDescLooper 0x81669 //FE8 -> 0x88B41
  #define WRankGetter 0x816BD //FE8 -> 0x88B95
  #define SupportsConditional 0x81739 //FE8 -> 0x88C15

#ifdef ALTERNATE_SKILL_SUPPORT_PAGES
  #define ST_Skills ST_Trv
  #define ST_Skill1 0
  #define ST_Skill2 0
  #define ST_Skill3 0
  #define ST_Skill4 0
  #define ST_Skill5 0
  #define ST_Skill6 0
#endif

  PUSH
  
    ORG 0x8152C //FE8 -> 0x889D8
      POIN RText_Page1
    ORG 0x81534 //FE8 -> 0x889E0
      POIN RText_Page2
	ORG 0x8154C //FE8 -> 0x889F8
	    POIN RText_Page3
	
	#ifndef ALTERNATE_SKILL_SUPPORT_PAGES
	ORG 0x81524 //FE8 -> $889d0
      SHORT $e010 //Temporary r-text fix to prevent freezing
	#endif

	
  POP



// /*  === PAGE 1 ===  */


  ALIGN 4
  RText_Page1:

 #ifdef PRESS_SELECT_TO_VIEW_GROWTHS
    PersonalDataRText:
    RMenu(0,ST_Str,0,0,0x76,0x4,PersonalDataDesc1)
  #else
    PersonalDataRText:
    RMenu(0,ST_Str,0,0,0x76,0x4,PersonalDataDesc2)
  #endif


  ST_Name:
    RMenu(0,ST_Class,0,ST_Luck,0x18,0x50,0x0,NameDescGetter)

  ST_Class:
    RMenu(ST_Name,ST_Level,0,ST_Def,0x6,0x68,HTID_Class,ClassDescGetter)

  ST_Level:
    RMenu(ST_Class,ST_HP,0,ST_Exp,0x6,0x78,HTID_Level)

  ST_Exp:
    RMenu(ST_Class,ST_HP,ST_Level,ST_Res,0x26,0x78,HTID_Exp)

  ST_HP:
    RMenu(ST_Level,0,0,ST_Mov,0x6,0x88,HTID_HP)

  ST_Str:
    RMenu(PersonalDataRText,ST_Mag,ST_Name,ST_Con,0x66,0x18,HTID_Str,StrMagGetter)

  ST_Mag:
    RMenu(ST_Str,ST_Skl,ST_Name,ST_Aid,0x66,0x28,HTID_Mag)

  ST_Skl:
    RMenu(ST_Mag,ST_Spd,ST_Name,ST_Cond,0x66,0x38,HTID_Skl)

  ST_Spd:
    RMenu(ST_Skl,ST_Luck,ST_Name,ST_Affin,0x66,0x48,HTID_Spd)

  ST_Luck:
    RMenu(ST_Spd,ST_Def,ST_Name,ST_Talk,0x66,0x58,HTID_Luck)

  ST_Def:
    RMenu(ST_Luck,ST_Res,ST_Class,ST_Skills,0x66,0x68,HTID_Def)

  ST_Res:
    RMenu(ST_Def,ST_Mov,ST_Exp,ST_Skill1,0x66,0x78,HTID_Res)

  ST_Mov:
    RMenu(ST_Res,0,ST_Exp,ST_Skill4,0x66,0x88,HTID_Mov,MovHPDescGetter)

  ST_Con:
    RMenu(PersonalDataRText,ST_Aid,ST_Str,0,0xA6,0x18,HTID_Con)

  ST_Aid:
    RMenu(ST_Con,ST_Cond,ST_Mag,0,0xa6,0x28,HTID_Aid)

  ST_Cond:
    RMenu(ST_Aid,ST_Affin,ST_Skl,0,0xa6,0x38,0,ConditionGetter)

  ST_Affin:
    RMenu(ST_Cond,ST_Talk,ST_Spd,ST_AffinDesc,0xa6,0x48,HTID_Affin)

  ST_AffinDesc:
    RMenu(ST_Cond,ST_Talk,ST_Affin,0,0xbe,0x48,AffinityDescLooper,AffinityDescGetter)

  ST_Talk:
    RMenu(ST_Affin,ST_Skills,ST_Luck,0,0xA6,0x58,SS_TalkRText)

#ifdef ALTERNATE_SKILL_SUPPORT_PAGES
  ST_Trv:
    RMenu(ST_Talk,0,ST_Def,0,0xA6,0x68,HTID_Trv)
#endif

#ifndef ALTERNATE_SKILL_SUPPORT_PAGES
  ST_Skills:
    RMenu(ST_Talk,ST_Skill1,ST_Def,0,0xA6,0x68,SS_SkillsRText)

  ST_Skill1:
    RMenu(ST_Skills,ST_Skill4,ST_Res,ST_Skill2,0xa6,0x78,0,RTextLoop,SkillDescGetter)

  ST_Skill2:
    RMenu(ST_Skills,ST_Skill5,ST_Skill1,ST_Skill3,0xbe,0x78,1,RTextLoop,SkillDescGetter+4)

  ST_Skill3:
    RMenu(ST_Skills,ST_Skill6,ST_Skill2,0,0xd6,0x78,2,RTextLoop,SkillDescGetter+8)

  ST_Skill4:
    RMenu(ST_Skill1,0,ST_Mov,ST_Skill5,0xa6,0x88,3,RTextLoop,SkillDescGetter+12)

  ST_Skill5:
    RMenu(ST_Skill2,0,ST_Skill4,ST_Skill6,0xbe,0x88,4,RTextLoop,SkillDescGetter+16)

  ST_Skill6:
    RMenu(ST_Skill3,0,ST_Skill5,0,0xd6,0x88,5,RTextLoop,SkillDescGetter+20)
#endif


/*  === PAGE 2 ===  */

  ALIGN 4
  RText_Page2:


  ST_Inventory1: 
  RMenu(0,ST_Inventory2,ST_Name2,0,0x68,0x18,0,ItemDescLooper,ItemDescGetter)

  ST_Inventory2: 
  RMenu(ST_Inventory1,ST_Inventory3,ST_Name2,0,0x68,0x28,1,ItemDescLooper,ItemDescGetter)

  ST_Inventory3: 
  RMenu(ST_Inventory2,ST_Inventory4,ST_Name2,0,0x68,0x38,2,ItemDescLooper,ItemDescGetter)

  ST_Inventory4: 
  RMenu(ST_Inventory3,ST_Inventory5,ST_Name2,0,0x68,0x48,3,ItemDescLooper,ItemDescGetter)

  ST_Inventory5: 
  RMenu(ST_Inventory4,ST_Atk,ST_Name2,ST_Rng,0x68,0x58,4,ItemDescLooper,ItemDescGetter)

  ST_Atk: 
  RMenu(ST_Inventory5,ST_Hit,ST_Exp2,ST_Crit,0x76,0x78,HTID_Atk)

  ST_Hit: 
  RMenu(ST_Atk,0,ST_HP2,ST_Avo,0x76,0x88,HTID_Hit)

  ST_Rng: 
  RMenu(ST_Inventory5,ST_Crit,ST_Atk,0,0xAE,0x68,HTID_Rng)

  ST_Crit: 
  RMenu(ST_Rng,ST_Avo,ST_Atk,0,0xAE,0x78,HTID_Crit)

  ST_Avo: 
  RMenu(ST_Crit,0,ST_Hit,0,0xAE,0x88,HTID_Avo)

  
  ST_Name2: 
  RMenu(0,ST_Class2,0,ST_Inventory4,0x18,0x50,0,NameDescGetter)

  ST_Class2: 
  RMenu(ST_Name2,ST_Level2,0,ST_Atk,0x6,0x68,HTID_Class,ClassDescGetter)

  ST_Level2: 
  RMenu(ST_Class2,ST_HP2,0,ST_Exp2,0x6,0x78,HTID_Level)

  ST_Exp2: 
  RMenu(ST_Class2,ST_HP2,ST_Level2,ST_Atk,0x26,0x78,HTID_Exp)

  ST_HP2: 
  RMenu(ST_Level2,0,0,ST_Hit,0x6,0x88,HTID_HP)



// /*  === PAGE 3 ===  */

#ifdef ALTERNATE_SKILL_SUPPORT_PAGES

  ALIGN 4
  RText_Page3:

  ST_WRank1:
  RMenu(0,ST_WRank2,ST_Name3,ST_P3Skill1,0x68,0x18,0x348)

  ST_WRank2:
  RMenu(ST_WRank1,ST_WRank3,ST_Name3,ST_P3Skill2,0x68,0x28,0x349)

  ST_WRank3:
  RMenu(ST_WRank2,ST_WRank4,ST_Name3,ST_P3Skill3,0x68,0x38,0x34A)

  ST_WRank4:
  RMenu(ST_WRank3,ST_WRank5,ST_Name3,ST_P3Skill4,0x68,0x48,0x34B)

  ST_WRank5:
  RMenu(ST_WRank4,ST_WRank6,ST_Name3,ST_P3Skill5,0x68,0x58,0x34C)

  ST_WRank6:
  RMenu(ST_WRank5,ST_WRank7,ST_Name3,ST_P3Skill6,0x68,0x68,0x34D)

  ST_WRank7:
  RMenu(ST_WRank6,ST_WRank8,ST_Name3,ST_P3Skill6,0x68,0x78,0x34E)

  ST_WRank8:
  RMenu(ST_WRank7,0,ST_HP3,ST_P3Skill6,0x68,0x88,0x34F)

  ST_P3Skill1:
  RMenu(0,ST_P3Skill2,ST_WRank1,0,0xA6,0x18,0,RTextLoop,SkillDescGetter)

  ST_P3Skill2:
  RMenu(ST_P3Skill1,ST_P3Skill3,ST_WRank2,0,0xA6,0x28,1,RTextLoop,SkillDescGetter+4)

  ST_P3Skill3:
  RMenu(ST_P3Skill2,ST_P3Skill4,ST_WRank3,0,0xA6,0x38,2,RTextLoop,SkillDescGetter+8)

  ST_P3Skill4:
  RMenu(ST_P3Skill3,ST_P3Skill5,ST_WRank4,0,0xA6,0x48,3,RTextLoop,SkillDescGetter+12)

  ST_P3Skill5:
  RMenu(ST_P3Skill4,ST_P3Skill6,ST_WRank5,0,0xA6,0x58,4,RTextLoop,SkillDescGetter+16)

  ST_P3Skill6:
  RMenu(ST_P3Skill5,0,ST_WRank6,0,0xA6,0x68,5,RTextLoop,SkillDescGetter+20)

  ST_Name3:
  RMenu(0,ST_Class3,0,ST_WRank6,0x18,0x50,0,NameDescGetter)

  ST_Class3:
  RMenu(ST_Name3,ST_Level3,0,ST_WRank7,0x6,0x68,HTID_Class,ClassDescGetter)

  ST_Level3:
  RMenu(ST_Class3,ST_HP3,0,ST_Exp3,0x6,0x78,HTID_Level)

  ST_Exp3:
  RMenu(ST_Class3,ST_HP3,ST_Level3,ST_WRank8,0x26,0x78,HTID_Exp)

  ST_HP3:
  RMenu(ST_Level3,0,0,ST_WRank8,0x6,0x88,HTID_HP)


// /*  === PAGE 4 ===  */

  ALIGN 4
  RText_Page4:

  ST_Bonus:
  RMenu(0,ST_Atk4,ST_Name4,ST_Supports4,0x66,0x18,HTID_Affin)

  ST_Atk4:
  RMenu(ST_Bonus,ST_Def4,ST_Name4,ST_Supports4,0x66,0x28,HTID_Atk)

  ST_Def4:
  RMenu(ST_Atk4,ST_Hit4,ST_Class4,ST_Supports4,0x66,0x38,HTID_Def)

  ST_Hit4:
  RMenu(ST_Def4,ST_Avo4,ST_Class4,ST_Supports4,0x66,0x48,HTID_Hit)

  ST_Avo4:
  RMenu(ST_Hit4,ST_Crit4,ST_Name4,ST_Supports4,0x66,0x58,HTID_Avo)

  ST_Crit4:
  RMenu(ST_Avo4,ST_Ddg4,ST_Level4,ST_Supports4,0x66,0x68,HTID_Crit)

  ST_Ddg4:
  RMenu(ST_Crit4,0,ST_HP4,ST_Supports4,0x66,0x78,SS_DdgRText)

  ST_Supports4:
  RMenu_Cond(0,ST_Name4,ST_Bonus,0,0xA0,0x18,HTID_Supports,SupportsConditional)

  ST_Name4:
  RMenu(0,ST_Class4,0,ST_Supports4,0x18,0x50,0,NameDescGetter)

  ST_Class4:
  RMenu(ST_Name4,ST_Level4,0,ST_Supports4,0x6,0x68,HTID_Class,ClassDescGetter)

  ST_Level4:
  RMenu(ST_Class4,ST_HP4,0,ST_Exp4,0x6,0x78,HTID_Level)

  ST_Exp4:
  RMenu(ST_Class4,ST_HP4,ST_Level4,ST_Supports4,0x26,0x78,HTID_Exp)

  ST_HP4:
  RMenu(ST_Level4,0,0,ST_Supports4,0x6,0x88,HTID_HP)

#else

  ALIGN 4
  RText_Page3:

  ST_WRank1:
  RMenu(0,ST_WRank2,ST_Name3,ST_WRank3,0x68,0x18,0,WRankGetter)

  ST_WRank2:
  RMenu(ST_WRank1,ST_Supports,ST_Name3,ST_WRank4,0x68,0x28,1,WRankGetter)

  ST_WRank3:
  RMenu(0,ST_WRank4,ST_WRank1,0,0xA8,0x18,2,WRankGetter)

  ST_WRank4:
  RMenu(ST_WRank3,ST_Supports,ST_WRank2,0,0xA8,0x28,3,WRankGetter)

  ST_Supports:
  RMenu_Cond(ST_WRank2,ST_Name3,ST_Name3,0,0x80,0x40,HTID_Supports,SupportsConditional) 


  ST_Name3:
  RMenu(0,ST_Class3,0,ST_Supports,0x18,0x50,0,NameDescGetter)

  ST_Class3:
  RMenu(ST_Name3,ST_Level3,0,ST_Supports,0x6,0x68,HTID_Class,ClassDescGetter)

  ST_Level3:
  RMenu(ST_Class3,ST_HP3,0,ST_Exp3,0x6,0x78,HTID_Level)

  ST_Exp3:
  RMenu(ST_Class3,ST_HP3,ST_Level3,ST_Supports,0x26,0x78,HTID_Exp)

  ST_HP3:
  RMenu(ST_Level3,0,0,ST_Supports,0x6,0x88,HTID_HP)

#endif


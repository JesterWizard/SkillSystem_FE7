#ifndef UNIT_MENU
#define UNIT_MENU

#include "Extensions/Hack Installation.txt"
#include "_UnitMenuDefs.event"

// FE7 gMenu_UnitMenu is at 0x08B95AAC. Only the items pointer at +0x08
// is replaced. Do not patch FE8 menu geometry ORGs.

PUSH
  ORG $B95AB4
    POIN UnitMenuTable
POP

ALIGN 4
UnitMenuTable:
  UM_Seize
  #ifdef ESCAPE_ARRIVE
    MenuCommand(ArriveName, ArriveDesc, BlueText, ArriveCommandUsability, ArriveCommandEffect)
    MenuCommand(EscapeName, EscapeDesc, BlueText, EscapeCommandUsability, EscapeCommandEffect)
  #endif

  #ifdef DRAGON_VEINS
  MenuCommand(UMText_DV, UMText_DVDesc, GreenText, VeinUsability, VeinEffect)
  #endif

  UM_Attack
  UM_Attack_B
  #ifdef GAIDEN_MAGIC
	MenuCommand(UM_GaidenBlackMagic,UM_GaidenMagicDesc,NormalText,GaidenBlackMagicUMUsability,GaidenBlackMagicUMEffect,GaidenBlackMagicUMHover,GaidenMagicUMUnhover)
	MenuCommand(UM_GaidenWhiteMagic,UM_GaidenMagicDesc,NormalText,GaidenWhiteMagicUMUsability,GaidenWhiteMagicUMEffect,GaidenWhiteMagicUMHover,GaidenMagicUMUnhover)
  #endif
  MenuCommand(UM_CombatArts, UM_CombatArtsDesc, NormalText, SkillsUsability, SkillsEffect)

  UM_Staff
  UM_Ride
  UM_Exit
  UM_Play
  MenuCommand(0x10CE, 0x355, NormalText, NewDanceUsability, 0x22095)

#ifdef INSTALL_AoE
#define MenuCommand_BPress(name,description,colour,usability,effect, unknown2) "WORD FE7_UM_DummyName; SHORT name description; BYTE colour $80; SHORT 0; POIN usability|1; WORD 0; POIN effect|1; POIN 0 0 unknown2|1"
  MenuCommand_BPress(UM_AoEName, UM_AoEDesc, NormalText, AoE_AreAnyUsable, AoE_Effect, AoE_ClearGraphics)
#endif

  UM_Steal
  UM_Summon_DK

  UM_Talk
  UM_Support
  UM_Visit

  #ifdef RAID
    MenuCommand(RaidNameText,RaidDescText,NormalText,RaidUsability,RaidEffect)
  #endif

  #ifdef STAIRS_ASM
	MenuCommand(StairsNameText,StairsDescText,GreenText,StairsUsability,StairsEffect)
  #endif

  UM_Chest
  UM_Door
  UM_Armory
  UM_Vendor
  UM_SecretShop

  UM_Rescue
  UM_Give
  UM_Take
  UM_Drop

  UM_Item
  UM_Trade
  MenuCommand(0x10DF, 0x367, GreenText, NewSupplyUsability, 0x22DB5)

  UM_Wait
  UM_Separator

#endif // UNIT_MENU

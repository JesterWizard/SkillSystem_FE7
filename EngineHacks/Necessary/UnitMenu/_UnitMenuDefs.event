#define FE7_UM_DummyName $81C3EA0
#define MenuCommand(name,description,colour,usability,effect) "WORD FE7_UM_DummyName; SHORT name description; BYTE colour $80; SHORT 0; POIN usability|1; WORD 0; POIN effect|1; WORD 0 0 0"
#define MenuCommand(name,description,colour,usability,effect, unknown1, unknown2) "WORD FE7_UM_DummyName; SHORT name description; BYTE colour $80; SHORT 0; POIN usability|1; WORD 0; POIN effect|1; POIN 0 unknown1|1 unknown2|1"


#ifndef EXPANDED_MODULAR_SAVE_INTERNALS
#define EXPANDED_MODULAR_SAVE_INTERNALS

// FE7U hook sites (ported from FE8 EMS; verified against FE7 Decomp.txt)

#include "SrcCore/MSCore.lyn.event"

#ifndef LynJumpDefined
	#define LynJumpDefined
	#define LynJump(aTarget) "WORD $46C04778 $E59FC000 $E12FFF1C; POIN aTarget; "
#endif // LynJumpDefined

gMS_ChapterStateChunkId:  BYTE EMS_CHUNK_CHAPTERSTATE
gMS_BWLChunkId:           BYTE EMS_CHUNK_BWLENTRIES
gMS_PermanentEidsChunkId: BYTE EMS_CHUNK_EIDS_PERMANENT
gMS_ClaimFlagsChunkId:    BYTE EMS_CHUNK_BONUSCLAIMDATA
gMS_WMDataChunkId:        BYTE EMS_CHUNK_WMDATA

#include "SrcCore/MSSizeHook.lyn.event"
#include "SrcCore/MSBWLHook.lyn.event"

PUSH
	// ComputeSaveChecksum → always succeed (EMS owns layout)
	ORG $0A1970
		SHORT $202A $4770 // mov r0, #42; bx lr

	// WriteSaveBlockInfo size literals (game / suspend / link)
	ORG $09E7E4
		SHORT EMS_GAME_BLOCK_SIZE
	ORG $09E7F0
		SHORT EMS_SUSPEND_BLOCK_SIZE
	ORG $09E7FC
		SHORT EMS_LINK_BLOCK_SIZE

	// GetSaveDataLocation
	ORG $09E870
		LynJump(MS_GetSaveAddressBySlot)

	// CopySaveGame
	ORG $0A065C
		LynJump(MS_CopyGameSave)

	// SaveGame / LoadGame
	ORG $0A0810
		LynJump(MS_SaveGame)
	// LoadGame entry is $0A08EC (push), not $0A08EE — hooking mid-prologue
	// left an unmatched push and corrupted the stack on restart/load.
	ORG $0A08EC
		LynJump(MS_LoadGame)

	// SaveSuspendedGame / LoadSuspendedGame
	ORG $0A1100
		LynJump(MS_SaveSuspend)
	ORG $0A1258
		LynJump(MS_LoadSuspend)

	// LoadSavedChapterState / LoadSuspendedChapterState
	ORG $0A09B4
		LynJump(MS_LoadChapterStateFromGameSave)
	ORG $0A13D8
		LynJump(MS_LoadChapterStateFromSuspendSave)

	// LoadSavedBonusClaimFlags
	ORG $0A09D4
		LynJump(MS_GetClaimFlagsFromGameSave)

	// BWL single-byte save hook (skill-system compat)
	ORG $09FE76
		SHORT $46C0 // nop for alignment
		LynJump(MS_BWLSaveHook)

	// SaveNewGame: keep RAM clears; skip vanilla SRAM chunk writes; finish with MS_SaveGame.
	// ClearUnits / ClearConvoy already ran earlier in this function.
	ORG $0A077C
		WORD $46C046C0 // nop; skip chapter-state SRAM write
	ORG $0A0782
		SHORT $46C0
		SHORT $46C0 // nop; skip SetBonusContentClaimFlags
	ORG $0A0788
		WORD $46C046C0 // nop; skip SaveBonusClaimFlags
	ORG $0A078C
		SHORT $E018 // b @$0A07C0; skip unit SRAM pack loop (units already cleared in WRAM)
	ORG $0A07C0
		WORD $46C046C0 // nop; skip vanilla SaveConvoy
	// @$0A07C6 still calls SaveClearedBWL… (RAM clear; SRAM writes skipped below)
	ORG $09F9B4
		SHORT $E022 // b epilogue of SaveClearedBWL…; skip BWL/win SRAM writes
	ORG $0A07D0
		WORD $46C046C0 // nop; skip vanilla SavePermanentEids
	// Vanilla here is mov r1, r8; bl WriteSaveBlockInfo (r0=sp buffer).
	// MS_SaveGame wants the slot in r0 (held in r8 since function entry).
	ORG $0A07DC
		SHORT $4640 // mov r0, r8
	ORG $0A07DE
		BL($0A0810) // MS_SaveGame (via LynJump); returns @ $0A07E2
	ORG $0A07E2
		SHORT $E001 // b @$0A07E8 epilogue; skip UpdateLastUsed (done in MS_SaveGame)
POP

#endif // EXPANDED_MODULAR_SAVE_INTERNALS

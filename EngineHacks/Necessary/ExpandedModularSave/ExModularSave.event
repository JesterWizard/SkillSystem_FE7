#ifndef EXPANDED_MODULAR_SAVE
#define EXPANDED_MODULAR_SAVE

// Expanded and Modular Game and Suspend Save (StanH_ / Colorz plan)
// FE7U port for Skill System (DEC-68). FE8-only chunks (WM skirmish RNG,
// Valni/Lagdou, world-map blob, event-slot counter) are omitted.

// ========================
// = SAVE DATA ALLOCATION =
// ========================

// Game blocks grown to $1400 so a 200-item convoy ($190) and BWL support
// exp ($1F0) fit. Link arena is shifted/shrunk; block 6 stays at $7400.

#define EMS_GAME_BLOCK_SIZE     $1400
#define EMS_SUSPEND_BLOCK_SIZE  $2E78
#define EMS_LINK_BLOCK_SIZE     $8B4
#define EMS_GAME1_OFFSET        $2F4C
#define EMS_GAME2_OFFSET        $434C
#define EMS_GAME3_OFFSET        $574C
#define EMS_LINK_OFFSET         $6B4C
#define EMS_CONVOY_CHUNK_SIZE   $0190
#define EMS_CHAPTERSTATE_SIZE   $0048

ALIGN 4
gSaveBlockDecl:
	//    offst type // desc
	SHORT EMS_GAME1_OFFSET 0    // 0: game 1
	SHORT EMS_GAME2_OFFSET 0    // 1: game 2
	SHORT EMS_GAME3_OFFSET 0    // 2: game 3
	SHORT $00D4 1               // 3: suspend 1
	SHORT $00D4 1               // 4: suspend 2 (same as suspend 1)

	SHORT EMS_LINK_OFFSET 2     // 5: link arena (shrunk)
	SHORT $7400 3               // 6: save-based chapters (vanilla)

ALIGN 4
gSaveBlockTypeSizeLookup:
	SHORT EMS_GAME_BLOCK_SIZE
	SHORT EMS_SUSPEND_BLOCK_SIZE
	SHORT EMS_LINK_BLOCK_SIZE
	SHORT $0C00

/* Layout:
  meta       0x0000  0xD4
  suspend    0x00D4  0x2E78
  save1      0x2F4C  0x1400
  save2      0x434C  0x1400
  save3      0x574C  0x1400
  link       0x6B4C  0x08B4
  other      0x7400  0x0C00
*/

// ================================
// = CHUNK IDENTIFIER DEFINITIONS =
// ================================

#define EMS_CHUNK_CHAPTERSTATE   1
#define EMS_CHUNK_SAVEUNITS      2
#define EMS_CHUNK_CONVOYITEMS    3
#define EMS_CHUNK_BWLENTRIES     4
#define EMS_CHUNK_WINDATA        5
#define EMS_CHUNK_EIDS_PERMANENT 6
#define EMS_CHUNK_BONUSCLAIMDATA 7
#define EMS_CHUNK_WMDATA         8

// ===========
// = MODULES =
// ===========

#include "SrcCore/MSaFuncs.lyn.event"
#include "SrcCore/MSuFuncs.lyn.event"
#include "SrcModules/Debuffs.lyn.event"

// Expanded convoy chunk I/O (DEC-61 / DEC-68)
#include "../ExpandedConvoy/asm/SaveLoadConvoy.lyn.event"

#ifdef USE_STRMAG_SPLIT
	#ifdef STAIRS_ASM
		MESSAGE EMS with strmag and Stair
		#include "SrcModules/SaveUnitExpandedStrmagStairs.lyn.event"
	#else
		#include "SrcModules/SaveUnitExpandedStrmag.lyn.event"
	#endif // STAIRS_ASM
#else
	#ifdef STAIRS_ASM
		#include "SrcModules/SaveUnitExpandedStairs.lyn.event"
	#else
		#include "SrcModules/SaveUnitExpanded.lyn.event"
	#endif // STAIRS_ASM
#endif // USE_STRMAG_SPLIT

DebuffTablePointer:
	WORD DebuffTableRam

// ===============
// = SAVE CHUNKS =
// ===============

#define DeclSaveChunk(aOffset, aSize, apSaver, apLoader) "SHORT (aOffset) (aSize); POIN (apSaver) (apLoader); SHORT 0 0"
#define DeclSaveChunk(aOffset, aSize, apSaver, apLoader, aIdentifier) "SHORT (aOffset) (aSize); POIN (apSaver) (apLoader); SHORT (aIdentifier) 0"
#define DeclSaveChunkEnd "SHORT 0xFFFF 0 0 0 0 0"

ALIGN 4
gGameSaveChunks:
	DeclSaveChunk(0, 0, 0, $0174D8+1) // ClearUnits on load

	DeclSaveChunk($0000, EMS_CHAPTERSTATE_SIZE, MSa_SaveChapterState, MSa_LoadChapterState, EMS_CHUNK_CHAPTERSTATE)
	DeclSaveChunk($0048, EMS_CONVOY_CHUNK_SIZE, MSa_SaveConvoyExpanded, MSa_LoadConvoyExpanded, EMS_CHUNK_CONVOYITEMS)
	DeclSaveChunk($01D8, $0460, $09FAEC+1,            $09FAA4+1,            EMS_CHUNK_BWLENTRIES)
	DeclSaveChunk($0638, $00C0, $09FB10+1,            $09FAD0+1,            EMS_CHUNK_WINDATA)
	DeclSaveChunk($06F8, $0019, $09E954+1,            $09E99C+1,            EMS_CHUNK_EIDS_PERMANENT)
	DeclSaveChunk($0714, $0004, MSa_SaveBonusClaim,   MSa_LoadBonusClaim,   EMS_CHUNK_BONUSCLAIMDATA)

	// Save 62 blue units (62 * 0x2C = $0AA8)
	DeclSaveChunk($0718, $0AA8, ESU_SaveGameUnits, ESU_LoadGameUnits, EMS_CHUNK_SAVEUNITS)

	// BWL support exp (DEC-59), 0x46 pids * 7 slots padded to 0x1F0
	// |1: BwlSupports.lyn labels are even (CURRENTOFFSET+$0 base)
	DeclSaveChunk($11C0, $01F0, SUD_SaveBwlSupports|1, SUD_LoadBwlSupports|1)

	// ends $13B0; free up to EMS_GAME_BLOCK_SIZE ($1400)

	DeclSaveChunkEnd

// ==================
// = SUSPEND CHUNKS =
// ==================

ALIGN 4
gSuspendSaveChunks:
	DeclSaveChunk(0, 0, 0, $0174D8+1) // ClearUnits on load

	DeclSaveChunk($0000, EMS_CHAPTERSTATE_SIZE, MSa_SaveChapterState, MSa_LoadChapterState, EMS_CHUNK_CHAPTERSTATE)
	DeclSaveChunk($0048, $0038, MSu_SaveActionState,  MSu_LoadActionState)
	DeclSaveChunk($0080, $0200, $0A18D8+1,            $0A18F4+1)            // Traps
	DeclSaveChunk($0280, EMS_CONVOY_CHUNK_SIZE, MSa_SaveConvoyExpanded, MSa_LoadConvoyExpanded)
	DeclSaveChunk($0410, $0460, $09FAEC+1,            $09FAA4+1)            // BWL
	DeclSaveChunk($0870, $00C0, $09FB10+1,            $09FAD0+1)            // Chapter win data
	DeclSaveChunk($0930, $0005, $09E934+1,            $09E974+1)            // Temporary eids

	// 62 blue units (62 * 0x34 = $0C98)
	DeclSaveChunk($0938, $0C98, ESU_SavePlayerSuspendUnits, ESU_LoadPlayerSuspendUnits)
	// 50 red units (50 * 0x38 = $0AF0)
	DeclSaveChunk($15D0, $0AF0, ESU_SaveRedSuspendUnits,    ESU_LoadRedSuspendUnits)
	// 20 green units (20 * 0x38 = $0460)
	DeclSaveChunk($20C0, $0460, ESU_SaveGreenSuspendUnits,  ESU_LoadGreenSuspendUnits)

	DeclSaveChunk($2520, DebuffTableSize, SUD_SaveDebuffs, SUD_LoadDebuffs)
	DeclSaveChunk($2960, $0019, $09E954+1, $09E99C+1) // Permanent eids

	// ends ~$2979; free up to $2E78

	DeclSaveChunk(0, 0, 0, MSu_LoadClaimFlagsFromParentSave)

	DeclSaveChunkEnd

#include "ExModularSaveInternals.event"

#endif // EXPANDED_MODULAR_SAVE

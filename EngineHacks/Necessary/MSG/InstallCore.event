#ifndef MSG_INSTALL_CORE_EVENT
#define MSG_INSTALL_CORE_EVENT

#include "EAstdlib.event"
#include "Extensions/Hack Installation.txt"

#ifndef _FE7_
	ERROR _file_ should be assembled for FE7
#endif // _FE7_

#include "CoreDefinitions.event"

// Comparators is macro-only (prCheckLessThan, needed by _Common.event's
// prMinZero under DEBUFFS_MIN_ZERO), so it is always safe to include.
#include "3rdParty/Comparators.event"

// The Inject*Getters files add getter call sites to vanilla code that reads
// Mov/Con/HP raw. They are Teq's FE8 work and still carry FE8 addresses in
// places -- e.g. InjectMovGetters ORG $87300 and InjectConGetters ORG $8731E,
// which in FE7 are RegisterObjectSafe OAM sprite code, not stat-screen getter
// calls. Patching them into FE7 corrupts live sprite code. They are opt-in
// until each ORG has been re-derived against FE7.
#ifdef MSG_INSTALL_3RDPARTY_INJECTORS
	#include "3rdParty/InjectMovGetters.event"
	#include "3rdParty/InjectConGetters.event"
	#include "3rdParty/InjectHPGetters.event"
#endif // MSG_INSTALL_3RDPARTY_INJECTORS

// FE7 GetUnit* entry points (mss_defs.s). jumpToHack frees the vanilla bodies;
// MagGetter lives at Pow+8 (0x18AD8), same pattern as FE8 Mag at Pow+8.
PUSH
	ORG 0x18AB0
	prGotoMaxHPGetter:
		jumpToHack(prMaxHPGetter)

	ORG 0x18A70
	prGotoCurHPGetter:
		jumpToHack(prCurHPGetter)

	ORG 0x18AD0
	prGotoPowGetter:
		jumpToHack(prPowGetter)

	ORG 0x18AF0
	prGotoSklGetter:
		jumpToHack(prSklGetter)

	ORG 0x18B30
	prGotoSpdGetter:
		jumpToHack(prSpdGetter)

	ORG 0x18B70
	prGotoDefGetter:
		jumpToHack(prDefGetter)

	ORG 0x18B90
	prGotoResGetter:
		jumpToHack(prResGetter)

	ORG 0x18BB8
	prGotoLckGetter:
		jumpToHack(prLckGetter)

	ORG 0x18450
	prGotoAidGetter:
		jumpToHack(prAidGetter)
	
	// Replaces part of old spd getter
	ORG 0x18B44
	prGotoMovGetter:
		jumpToHack(prMovGetter)
	
	// Replaces part of old res getter
	ORG 0x18BA4
	prGotoConGetter:
		jumpToHack(prConGetter)

	#ifdef USE_STRMAG_SPLIT
		// Mag trampoline at Pow+8, same pattern as FE8 Mag at Pow+8.
		ORG 0x18AD8
		prGotoMagGetter:
			jumpToHack(MagGetter)
	#endif // USE_STRMAG_SPLIT
POP

#include "3rdParty/InjectMovGetters_FE7.event"

#include "Core.lyn.event" 
/*
prCallSequence:
	SHORT 0xB5F0 0x1C0C 0x1C15 0x1C1E 0x467F 0x3701 0xCE08 0x2B00 0xD005 0x2101 0x430B 0x1C21 0x1C2A 0x46BE 0x4718 0xBCF0 0xBC02 0x4708
*/
ALIGN 4 
prMaxHPGetter:
	SHORT 0xB500 0x4B04 0x469E 0x4B04 0x1C0A 0x1C01 0x2000 0xF800 0xBC02 0x4708; POIN prCallSequence pMaxHPModifiers
prCurHPGetter:
	SHORT 0xB500 0x4B04 0x469E 0x4B04 0x1C0A 0x1C01 0x2000 0xF800 0xBC02 0x4708; POIN prCallSequence pCurHPModifiers
prPowGetter:
	SHORT 0xB500 0x4B04 0x469E 0x4B04 0x1C0A 0x1C01 0x2000 0xF800 0xBC02 0x4708; POIN prCallSequence pPowerModifiers
prSklGetter:
	SHORT 0xB500 0x4B04 0x469E 0x4B04 0x1C0A 0x1C01 0x2000 0xF800 0xBC02 0x4708; POIN prCallSequence pSkillModifiers
prSpdGetter:
	SHORT 0xB500 0x4B04 0x469E 0x4B04 0x1C0A 0x1C01 0x2000 0xF800 0xBC02 0x4708; POIN prCallSequence pSpeedModifiers
prDefGetter:
	SHORT 0xB500 0x4B04 0x469E 0x4B04 0x1C0A 0x1C01 0x2000 0xF800 0xBC02 0x4708; POIN prCallSequence pDefenseModifiers
prResGetter:
	SHORT 0xB500 0x4B04 0x469E 0x4B04 0x1C0A 0x1C01 0x2000 0xF800 0xBC02 0x4708; POIN prCallSequence pResistanceModifiers
prLckGetter:
	SHORT 0xB500 0x4B04 0x469E 0x4B04 0x1C0A 0x1C01 0x2000 0xF800 0xBC02 0x4708; POIN prCallSequence pLuckModifiers
prAidGetter:
	SHORT 0xB500 0x4B04 0x469E 0x4B04 0x1C0A 0x1C01 0x2000 0xF800 0xBC02 0x4708; POIN prCallSequence pAidModifiers
prConGetter:
	SHORT 0xB500 0x4B04 0x469E 0x4B04 0x1C0A 0x1C01 0x2000 0xF800 0xBC02 0x4708; POIN prCallSequence pConModifiers

prStatScreenMovGetter:
	SHORT 0xB510 0x68E8 0x1C04 0xF000 0xF80D 0x2800 0xD103 0x2001 0x4240 0x1C03 0xE002 0x6863 0x2112 0x565B 0xBC10 0xBC02 0x4708 0x46C0
prMovGetter:
	SHORT 0xB500 0x4B04 0x469E 0x4B04 0x1C0A 0x1C01 0x2000 0xF800 0xBC02 0x4708; POIN prCallSequence pMovModifiers

#ifdef USE_STRMAG_SPLIT
ALIGN 4
// StrMagSplit (CombatCalculations.event, PrepScreen.event) references MagGetter
// by label, so keep that name on the modular chain.
MagGetter:
prMagGetter:
	SHORT 0xB500 0x4B04 0x469E 0x4B04 0x1C0A 0x1C01 0x2000 0xF800 0xBC02 0x4708; POIN prCallSequence pMagicModifiers
#endif // USE_STRMAG_SPLIT


#endif // MSG_INSTALL_CORE_EVENT

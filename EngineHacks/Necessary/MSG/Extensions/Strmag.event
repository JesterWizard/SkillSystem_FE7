
#include "EAstdlib.event"
#include "Extensions/Hack Installation.txt"

#ifndef STRMAG_MSG
	#define STRMAG_MSG

	// FE7 Mag at unit+0x47.
	// Hook Pow at 0x18AD0 (frees vanilla body); Mag trampoline at 0x18AD8.
	#define UNIT_MAGIC 0x47

	PUSH
	ORG 0x18AD0
		jumpToHack(prPowGetter)
	ORG 0x18AD8
		prGotoMagGetter:
			jumpToHack(MagGetter)
	POP

	ALIGN 4
	prPowGetter:
		#incbin "PowGetter.dmp"

	ALIGN 4
	MagGetter:
	prMagGetter:
		#incbin "MagGetter.dmp"

#endif // STRMAG_MSG

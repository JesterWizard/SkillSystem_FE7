#ifndef HAX_CONFIG
#define HAX_CONFIG

// Switches for Skill System, Vesly debugger, and skill-plumbing Necessary modules.

// =========================
// = GENERAL CONFIGURATION =
// =========================

// Attack speed needed to double. Used if CanUnitDoubleCalcLoop is included.
#define AS_DOUBLING_THRESHOLD 4

// If uncommented, Lyn Mode tutorial events and ASM restrictions (End Turn, cursor lock) are stubbed out.
#define DISABLE_TUTORIALS

// Bly extra narrow serif (*) / menu (^) glyphs in unused 0x81+ font slots.
// Comment out to skip install. This is not the UTF-8 font rewrite.
#define NARROW_FONT

// If uncommented, will use allegiance-based statscreen palettes.
#define STATSCREEN_ALLEGIANCE

// =================================
// = SKILL BEHAVIOUR CONFIGURATION =
// =================================

// If commented, slayer and effectiveness stay vanilla.
// See SkillSystem/Skills/EffectivenessSkills/Nullify/_README.txt.
#define ENABLE_SLAYER_AND_EFFECTIVENESS_REWORK

// Independent Strength and Magic (Mag at unit+0x47).
// Spirit Dust item ID defaults to Energy Ring in StrMagSplit/_MasterAsmInstaller.event.
#define USE_STRMAG_SPLIT

// If false, only the first inventory item with a passive skill applies.
// Item ability 0x00800000 enables passive skills on an item.
#define PASSIVE_SKILLS_STACK True

// If true, units under roof tiles count for aura skills.
#define ROOF_UNIT_AURAS True

// If true, both the Canto skill and the vanilla canto ability apply.
#define ENABLE_LEGACY_CANTO False

// If uncommented, Steal+ AI uses FE8 inline sites that are not steal AI on FE7.
// #define ENABLE_AI_STEAL_PLUS

// If commented, Steal is a character ability and Steal+ requires vanilla steal.
#define ENABLE_STEAL_SKILL

// If commented, debuffs may take stats below zero.
#define DEBUFFS_MIN_ZERO

// Shadowgift/Lumina: also check staff rank as the highest magic rank.
#define SHADOWGIFT_VIA_STAFF_RANK False
#define LUMINA_VIA_STAFF_RANK False

// If commented, Poison Strike and Grisly Wound apply even when battle damage was 0.
#define RESIDUAL_DAMAGE_REQUIRES_BATTLE_DAMAGE

// If uncommented, a weapon with 1 use remaining is a guaranteed crit.
#define LAST_HIT_CRIT

// If commented, Capture / Dragon Veins / Heroes Movement are global commands.
#define CAPTURE_SKILL_REQUIRED
#define DRAGON_VEIN_SKILL_REQUIRED
#define HEROES_MOVEMENT_SKILL_REQUIRED

// If HEROES_MOVEMENT_SKILL_REQUIRED is off, still allow the skill check.
#define ALSO_USE_MOVEMENT_SKILL_CHECK True

#define DOES_BARGAIN_STACK False

#define ALSO_USE_VANILLA_DANCE_CHECK False
// False while SupplyID is enabled: convoy is skill/adjacent-skill only.
// Merlinus's transporter class does not open Supply by itself.
#define ALSO_USE_VANILLA_SUPPLY_CHECK False
#define ALSO_USE_VANILLA_SUMMON_CHECK False
#define ALSO_USE_VANILLA_STEAL_CHECK True

// Combat Arts: extra durability per hit, selected from a submenu.
// #define COMBAT_ARTS
#define ARTS_HIT_ONCE True

// ModularPreBattleSkills (combat-art modifiers).
// #define MODULAR_PRE_BATTLE_SKILLS

// Range-skill checks use SkillTester2 (no equipped-weapon skills; avoids recursion).
// #define RANGE_SKILLS_CHECK_USES_SKILLTESTER2

// If uncommented, Moonbow uses skill% instead of Charge.
// #define DISABLE_CHARGE

// If uncommented, Triangle Attack uses the vanilla bitflag instead of a skill check.
// #define VANILLA_TRIANGLE_ATTACK

// If uncommented, Lethality uses original GBA rules.
// #define ENABLE_GBA_LETHALITY

// If uncommented, Galeforce auto-selects the unit (B does not end the turn).
// #define ENABLE_GALEFORCE_AUTOSELECT

#define HOARDERS_BANE_USE_CONVOY True

// If true, enemy/NPC Canto+ retreats to the safest remaining tile.
#define CANTO_AI True

// ================================
// = GROWTH DISPLAY CONFIGURATION =
// ================================

#define PRESS_SELECT_TO_VIEW_GROWTHS

#define USE_STAT_COLORS True

#define MIN_STAT_GAIN 1

#define BRACKETING_USE_BASE_LEVEL False

#define FIXED_GROWTHS_MODE False
#define FIXED_GROWTHS_FLAG_ID 0xEF

#define STAT_BRACKETING_EXISTS False
#define BRACKETED_GROWTHS_FLAG_ID 0xED // 0xEE hides battle anim damage numbers

// If uncommented, damage/heal numbers display over participants during battle animations.
#define BATTLE_ANIMATION_NUMBERS

// Flag that hides battle animation numbers when set (same default as FE8 Skill System).
#define BATTLE_ANIMATION_NUMBERS_FLAG 0xEE

#define FORCE_WHEN_BELOW_AVERAGE_BY_AMOUNT 3
#define PREVENT_WHEN_ABOVE_AVERAGE_BY_AMOUNT 5

#define FIXED_GROWTHS_DONT_BOOST True
#define ENEMY_NPC_FIXED_GROWTHS True
#define STACKABLE_GROWTH_BOOSTS True
#define METIS_TOME_BOOST 5
#define USE_CHAR_AND_CLASS_GROWTHS False

#endif // HAX_CONFIG


#include "MultiSkillScrolls.lyn.event"
#include "SkillLearnPopup.lyn.event"
#include "../../Necessary/PopupRework/Extensions/PopupDefinitions.txt"

ALIGN 4
SkillScrollMessageReturnLink:
SHORT PrepScreenUseSkillScroll // text ID

ALIGN 4
SkillScrollIDLink:
BYTE SkillScroll
ALIGN 4

// Modular skill-learned popup: [UnitName] learned [SkillIcon][SkillName]
// Uses CreatePopup; components 0x0D/0x0E added via expanded FE7 jump tables.
ALIGN 4
SkillLearnedPopupDef:
	Popup_SetSound(0x5A)
	Popup_UnitName
	Popup_StringId(LearnedSkillText)
	WORD 0x0D 0                    // skill icon
	Popup_SetColor(2)
	WORD 0x0E 0                    // skill name
	Popup_SetColor(0)
	Popup_End

// Blocking wrapper (FE8 LearnNewSkill style):
// CALL_ROUTINE_2 advances to END, starts CreatePopup as blocking child, returns 0.
// While popup holds lockCount, script does not run; when it ends, END runs and
// unblocks the item-action parent. Do NOT use PROC_BLOCK — it never advances.
ALIGN 4
LearnScrollPopupProc:
	SHORT 0x16 0 // CALL_ROUTINE_2
	POIN (CallScrollLearnedPopup|1)
	SHORT 0x00 0 0 0 // END

// FE7 CreatePopup length/display only allow component ids 1..0xC / 1..0xB.
// Extend both jump tables through 0x0E for skill icon + skill name.
PUSH
ORG $A7F4
SHORT 0x280D // cmp r0, #0x0D  (ids 1..0x0E after subs #1)
ORG $A804
POIN SkillPopupLengthJumpTable

ORG $A928
SHORT 0x280D // cmp r0, #0x0D  (display uses bhi; allow through 0x0E)
ORG $A938
POIN SkillPopupDisplayJumpTable
POP

ALIGN 4
SkillPopupLengthJumpTable:
WORD 0x0800A900 // 01 space
WORD 0x0800A8C4 // 02 item name
WORD 0x0800A8D8 // 03 item+article cap
WORD 0x0800A8EC // 04 item+article
WORD 0x0800A8AC // 05 unit name
WORD 0x0800A898 // 06 string id
WORD 0x0800A8A4 // 07 string ptr
WORD 0x0800A904 // 08 set color
WORD 0x0800A854 // 09 item icon
WORD 0x0800A874 // 0A wtype icon
WORD 0x0800A842 // 0B number
WORD 0x0800A838 // 0C sound
POIN (PopupLen_SkillIcon|1) // 0D
POIN (PopupLen_SkillName|1) // 0E

ALIGN 4
SkillPopupDisplayJumpTable:
WORD 0x0800A9F8 // 01
WORD 0x0800A9BC // 02
WORD 0x0800A9CC // 03
WORD 0x0800A9DC // 04
WORD 0x0800A9A8 // 05
WORD 0x0800A994 // 06
WORD 0x0800A99E // 07
WORD 0x0800A98A // 08
WORD 0x0800A980 // 09
WORD 0x0800A980 // 0A
WORD 0x0800A968 // 0B
WORD 0x0800AA00 // 0C sound (no-op display → loop)
POIN (PopupDisp_SkillIcon|1) // 0D
POIN (PopupDisp_SkillName|1) // 0E

// FE7 item jump tables: index = itemId - 0x4A, vanilla max item 0x9A (index 0x50).
// Expand through SkillScroll (0x9F => index 0x55) and repoint the three tables.

PUSH
ORG $16B76
SHORT 0x2855 // cmp r0, #0x55

ORG $26CFC
SHORT 0x2855

ORG $2D030
SHORT 0x2855

ORG $16B88
POIN SkillScrollUsabilityTable

ORG $26D0C
POIN SkillScrollTargetingTable

ORG $2D048
POIN SkillScrollEffectTable
POP

ALIGN 4
SkillScrollUsabilityTable:
#incbin "fe7_item_usability_table.bin" // 0x51 vanilla entries (0x00..0x50)
WORD 0x08016CD0 0x08016CD0 0x08016CD0 0x08016CD0 // 0x51..0x54
POIN (MultiScrollUsability|1)                   // 0x55 SkillScroll

ALIGN 4
SkillScrollTargetingTable:
#incbin "fe7_item_targeting_table.bin"
WORD 0x08026E54 0x08026E54 0x08026E54 0x08026E54
POIN (MultiScrollTargeting|1)                    // 0x55 SkillScroll (Use menu gates on this)

ALIGN 4
SkillScrollEffectTable:
#incbin "fe7_item_effect_table.bin"
WORD 0x0802D190 0x0802D190 0x0802D190 0x0802D190
POIN (MultiScrollEffect|1)

// FE7 prep usability: CanUnitUseItemPrepScreen @ 0x2803C
// index = itemId - 0x5A, vanilla max item 0x96 (index 0x3C).
// Expand through SkillScroll (0x9F => index 0x45) and repoint the table.
// Jump entries are entered with r4=item, r5=unit, stack={r4,r5,lr}
// (same trampoline MultiScrollPrepUsability expects).

PUSH
ORG $2805A
SHORT 0x2845 // cmp r0, #0x45

ORG $2806C
POIN SkillScrollPrepUsabilityTable
POP

ALIGN 4
SkillScrollPrepUsabilityTable:
#incbin "fe7_prep_usability_table.bin" // 0x3D vanilla entries (0x00..0x3C)
WORD 0x0802818C 0x0802818C 0x0802818C 0x0802818C // 0x3D..0x40
WORD 0x0802818C 0x0802818C 0x0802818C 0x0802818C // 0x41..0x44
POIN (MultiScrollPrepUsability|1)                 // 0x45 SkillScroll

// Prep effect: ApplyItemStatBoost (0x2CD28) is the prep booster apply+message
// entry used by PrepItemUseBooster. Early-out to MultiScrollPrepEffect.
PUSH
ORG $2CD28
jumpToHack(PrepScrollEffectDispatch)
POP

// Item 0x9F is the first free slot after vanilla 0x00..0x9E. Writing it at
// 0xBE222C + 0x24*0x9F overwrites Lord movement-cost data at 0xBE3888
// (plains become impassable → Mov 0 on the map). Keep 0x9F, but host the
// expanded table in FreeSpace and repoint GetItemData. Do not FILL/wipe 0x9A–0x9E.
ALIGN 4
ExpandedItemTable:
#incbin "fe7_item_table_through_9E.bin" // items 0x00..0x9E
SHORT 0xFFFF                            // 0x9F SkillScroll
SHORT 0xFFFF
SHORT SkillScrollDesc
BYTE SkillScroll
BYTE 0x09
WORD 0
WORD 0
WORD 0
BYTE 1
BYTE 0
BYTE 0
BYTE 0
BYTE 0
BYTE 0x11
SHORT 10000
BYTE 0
BYTE 0
BYTE 0x21                           // weaponEffectId: nonzero so Item Use menu shows Use
BYTE 0
BYTE 0
BYTE 1

#undef ItemTable
#define ItemTable ExpandedItemTable

// Vanilla helpers embed 0x8BE222C directly (MakeNewItem, getters, menu draws).
// GetItemData alone is not enough — debugger Give Item calls MakeNewItem(0x9F),
// which still read the vanilla slot and crashed into movement-cost data.
PUSH
ORG $16060
POIN ExpandedItemTable
ORG $1608C
POIN ExpandedItemTable
ORG $160B8
POIN ExpandedItemTable
ORG $160E4
POIN ExpandedItemTable
ORG $16110
POIN ExpandedItemTable
ORG $1613C
POIN ExpandedItemTable
ORG $16168
POIN ExpandedItemTable
ORG $161A0
POIN ExpandedItemTable
ORG $16300
POIN ExpandedItemTable
ORG $1634C
POIN ExpandedItemTable
ORG $163BC
POIN ExpandedItemTable
ORG $1640C
POIN ExpandedItemTable
ORG $16464
POIN ExpandedItemTable
ORG $164F0
POIN ExpandedItemTable
ORG $165C0
POIN ExpandedItemTable
ORG $1664C
POIN ExpandedItemTable
ORG $16714
POIN ExpandedItemTable
ORG $16758
POIN ExpandedItemTable
ORG $167EC
POIN ExpandedItemTable
ORG $16844
POIN ExpandedItemTable
ORG $168F0
POIN ExpandedItemTable
ORG $169BC
POIN ExpandedItemTable
ORG $16AD8
POIN ExpandedItemTable
ORG $16B54
POIN ExpandedItemTable
ORG $16D08
POIN ExpandedItemTable
ORG $16D5C
POIN ExpandedItemTable
ORG $16DA8
POIN ExpandedItemTable
ORG $16DD4
POIN ExpandedItemTable
ORG $16F50
POIN ExpandedItemTable
ORG $16FAC
POIN ExpandedItemTable
ORG $1702C
POIN ExpandedItemTable
ORG $1707C
POIN ExpandedItemTable
ORG $170F0
POIN ExpandedItemTable
ORG $17170
POIN ExpandedItemTable
ORG $171AC
POIN ExpandedItemTable
ORG $171E0
POIN ExpandedItemTable
ORG $17228
POIN ExpandedItemTable
ORG $17240
POIN ExpandedItemTable
ORG $17258
POIN ExpandedItemTable
ORG $17274
POIN ExpandedItemTable
ORG $17290
POIN ExpandedItemTable
ORG $172B4
POIN ExpandedItemTable
ORG $172D8
POIN ExpandedItemTable
ORG $172F4
POIN ExpandedItemTable
ORG $1730C
POIN ExpandedItemTable
ORG $17324
POIN ExpandedItemTable
ORG $1733C
POIN ExpandedItemTable
ORG $17360
POIN ExpandedItemTable
ORG $17380
POIN ExpandedItemTable
ORG $1739C
POIN ExpandedItemTable
ORG $173B4
POIN ExpandedItemTable
ORG $173CC
POIN ExpandedItemTable
ORG $173E4
POIN ExpandedItemTable
ORG $173FC
POIN ExpandedItemTable
ORG $17418
POIN ExpandedItemTable
ORG $17438
POIN ExpandedItemTable
ORG $17450
POIN ExpandedItemTable
ORG $17468
POIN ExpandedItemTable
ORG $17490
POIN ExpandedItemTable
ORG $174A8
POIN ExpandedItemTable
ORG $174BC

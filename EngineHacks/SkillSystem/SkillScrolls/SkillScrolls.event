
#include "MultiSkillScrolls.lyn.event"

ALIGN 4
SkillScrollMessageReturnLink:
SHORT PrepScreenUseSkillScroll // text ID

ALIGN 4
SkillScrollIDLink:
BYTE SkillScroll
ALIGN 4

// FE7 item jump tables index (itemId - 0x4A) for itemId in [0x4A, 0x9A].
// Expand range through SkillScroll (0xBC => index 0x72) and install extended tables.

PUSH
ORG $16B76
SHORT 0x2872 // cmp r0, #0x72

ORG $26CFC
SHORT 0x2872

ORG $2D030
SHORT 0x2872

ORG $16B88
POIN SkillScrollUsabilityTable

ORG $26D0C
POIN SkillScrollTargetingTable

ORG $2D048
POIN SkillScrollEffectTable
POP

ALIGN 4
SkillScrollUsabilityTable:
#incbin "fe7_item_usability_table.bin" // 0x51 vanilla entries
WORD 0x08016CD0 0x08016CD0 0x08016CD0 0x08016CD0 // 0x51..0x54
WORD 0x08016CD0 0x08016CD0 0x08016CD0 0x08016CD0 // 0x55..0x58
WORD 0x08016CD0 0x08016CD0 0x08016CD0 0x08016CD0 // 0x59..0x5C
WORD 0x08016CD0 0x08016CD0 0x08016CD0 0x08016CD0 // 0x5D..0x60
WORD 0x08016CD0 0x08016CD0 0x08016CD0 0x08016CD0 // 0x61..0x64
WORD 0x08016CD0 0x08016CD0 0x08016CD0 0x08016CD0 // 0x65..0x68
WORD 0x08016CD0 0x08016CD0 0x08016CD0 0x08016CD0 // 0x69..0x6C
WORD 0x08016CD0 0x08016CD0 0x08016CD0 0x08016CD0 // 0x6D..0x70
WORD 0x08016CD0                                 // 0x71
POIN (MultiScrollUsability|1)                   // 0x72 SkillScroll

ALIGN 4
SkillScrollTargetingTable:
#incbin "fe7_item_targeting_table.bin"
WORD 0x08026E54 0x08026E54 0x08026E54 0x08026E54
WORD 0x08026E54 0x08026E54 0x08026E54 0x08026E54
WORD 0x08026E54 0x08026E54 0x08026E54 0x08026E54
WORD 0x08026E54 0x08026E54 0x08026E54 0x08026E54
WORD 0x08026E54 0x08026E54 0x08026E54 0x08026E54
WORD 0x08026E54 0x08026E54 0x08026E54 0x08026E54
WORD 0x08026E54 0x08026E54 0x08026E54 0x08026E54
WORD 0x08026E54 0x08026E54 0x08026E54 0x08026E54
WORD 0x08026E54
POIN (MultiScrollTargeting|1)

ALIGN 4
SkillScrollEffectTable:
#incbin "fe7_item_effect_table.bin"
WORD 0x0802D190 0x0802D190 0x0802D190 0x0802D190
WORD 0x0802D190 0x0802D190 0x0802D190 0x0802D190
WORD 0x0802D190 0x0802D190 0x0802D190 0x0802D190
WORD 0x0802D190 0x0802D190 0x0802D190 0x0802D190
WORD 0x0802D190 0x0802D190 0x0802D190 0x0802D190
WORD 0x0802D190 0x0802D190 0x0802D190 0x0802D190
WORD 0x0802D190 0x0802D190 0x0802D190 0x0802D190
WORD 0x0802D190 0x0802D190 0x0802D190 0x0802D190
WORD 0x0802D190
POIN (MultiScrollEffect|1)

// Item 0xBC data (ItemTable @ 0xBE222C)
PUSH
ORG 0xBE222C + (0x24 * SkillScroll)
SHORT 0xFFFF
SHORT 0xFFFF
SHORT SkillScrollDesc
BYTE SkillScroll
BYTE 0x09
WORD 0
WORD 0
WORD 0
BYTE 1
BYTE 0
BYTE 0
BYTE 0
BYTE 0
BYTE 0x11
SHORT 10000
BYTE 0
BYTE 0
BYTE 0
BYTE 0
BYTE 0
BYTE 0
POP

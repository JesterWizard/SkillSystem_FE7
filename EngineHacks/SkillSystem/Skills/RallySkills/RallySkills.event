#ifndef HAX_RALLIES
#define HAX_RALLIES
#ifndef MSG_HAS_RALLY_FX
#define MSG_HAS_RALLY_FX
#endif

// Rally based on debuffs by crazycolorz5
// Rally skills by circleseverywhere (?)
// Rewritten by StanH_ to include cool effects

#include "MapAuraFx/MapAuraFx.event"

#ifndef DEBUFFS_HACK
ALIGN 4
DummyRallyDebuffEntry:
FILL 16
ALIGN 4
GetUnitDebuffEntry:
SHORT 0x4800 0x4770
POIN DummyRallyDebuffEntry
ALIGN 4
RalliesOffset_Link:
WORD 0
ALIGN 4
RalliesNumberOfBits_Link:
WORD 16
ALIGN 4
SpecRallyAmount_Link:
WORD 2
MagRallyAmount_Link:
WORD 4
StrRallyAmount_Link:
WORD 4
SklRallyAmount_Link:
WORD 4
SpdRallyAmount_Link:
WORD 4
DefRallyAmount_Link:
WORD 4
ResRallyAmount_Link:
WORD 4
LukRallyAmount_Link:
WORD 8
MovRallyAmount_Link:
WORD 2
ALIGN 2
SHORT $4770
#endif

#include "asm/Rally.lyn.event"
#include "asm/RallyFx.lyn.event"

// Note that the event engine *does not* wait for the animation to end for the ASMC. So STAL 34 is included in the macro. 
#define BuffAnim(unitID, rallyAnim, range) "SVAL s1 unitID; SVAL s3 rallyAnim; SVAL s4 range; ASMC BuffAnim_ASMC; STAL 34"
#define BuffAnim(unitID, rallyAnim) "SVAL s1 unitID; SVAL s3 rallyAnim; SVAL s4 0; ASMC BuffAnim_ASMC; STAL 34"


RallySkillList: 
	BYTE RallyStrID
	BYTE RallySklID
	BYTE RallySpdID
	BYTE RallyDefID
	BYTE RallyResID
	BYTE RallyLukID
	BYTE RallyMovID
	BYTE RallySpectrumID
	BYTE RallyMagID
	BYTE 0

ALIGN 4
RallyFxPaletteLookup:
	POIN gRallyStrengthPalette   // Rally strength
	POIN gRallySkillPalette      // Rally skill
	POIN gRallySpeedPalette      // Rally speed
	POIN gRallyDefensePalette    // Rally defense
	POIN gRallyResistancePalette // Rally resistance
	POIN gRallyLuckPalette       // Rally luck
	POIN gRallyMovePalette       // Rally mov
	POIN gRallyGenericPalette    // Rally spectrum
	POIN gRallyMagicPalette // Rally mag

gpRallyDebuffsAddr:
	WORD DebuffTableRam

ALIGN 4
gRallyPreviewPalette:
gRallyGenericPalette:
	#incext Png2Dmp "data/fx-preview.png" --palette-only

ALIGN 4
gRallyStrengthPalette:
	#incext Png2Dmp "data/fx-strength.png" --palette-only

ALIGN 4
gRallySkillPalette:
	#incext Png2Dmp "data/fx-skill.png" --palette-only

ALIGN 4
gRallySpeedPalette:
	#incext Png2Dmp "data/fx-speed.png" --palette-only

ALIGN 4
gRallyDefensePalette:
	#incext Png2Dmp "data/fx-defense.png" --palette-only

ALIGN 4
gRallyResistancePalette:
	#incext Png2Dmp "data/fx-resistance.png" --palette-only

ALIGN 4
gRallyLuckPalette:
	#incext Png2Dmp "data/fx-luck.png" --palette-only

ALIGN 4
gRallyMovePalette:
	#incext Png2Dmp "data/fx-move.png" --palette-only
	
ALIGN 4
gRallyMagicPalette:
	#incext Png2Dmp "data/fx-magic.png" --palette-only

#endif // HAX_RALLIES


ALIGN 4
Shadowgift: //Also includes Lumina
#include "Shadowgift/shadowgift.lyn.event"
POIN CheckSkillBuffer
WORD ShadowgiftID
WORD LuminaID
WORD SHADOWGIFT_VIA_STAFF_RANK
WORD LUMINA_VIA_STAFF_RANK
POIN ItemTable

ALIGN 4
Amische:
#include "Amische/Amische.lyn.event"
POIN CheckSkillBuffer
WORD AmischeID
POIN IronWeaponsList

#ifndef IronSword
#define IronSword 0x01
#define IronLance 0x14
#define IronAxe 0x1F
#define IronBow 0x2C
#endif

ALIGN 4
IronWeaponsList:
BYTE IronSword IronLance IronAxe IronBow
BYTE 0 //terminator
ALIGN 4

//FE8 Capture
//By Tequila

#ifdef _FE7_

	#define MSG_HAS_CAPTURE

	#include "Extensions/Hack Installation.txt"
	#include EAstdlib.event
	#include "Tools/Tool Helpers.txt"
	#include "Extensions/ProcDefinitions.txt" 

	//Reward for drop a enemy unit.
	//If you don't need it, set it to 0.
	//Maximum value is 100
	#define  GIVE_DROP_EXP	10

	PUSH

	// Replace FE7's post-battle death handler so a defeated target can be
	// rescued before vanilla death processing runs.
	ORG $2F960
	jumpToHack(After_Battle_Rescue)

	// Keep a rescued enemy's unit data from being cleared by KillUnit.
	ORG $17E90
	jumpToHack(Preserve_Captured_Enemy)

	// Include carried captured enemies in the trade target list.
	ORG $23CC0
	jumpToHack(Trade_Target_List)

	// Modify the trade checks so captured enemies can be traded while
	// preserving vanilla ally trading.
	ORG $25224
	callHack_r3(Trade_Captured_Enemy1)
	SHORT 0x46C0
	ORG $25298
	callHack_r3(Trade_Captured_Enemy2)
	SHORT 0xD00E

	// Use the blank mug when a trade participant has no valid portrait.
	// These are the two FE7 portrait getter calls in TradeMenu_Init.
	ORG $2B0D4
	callHack_r3(Trade_Portrait_Fix1)
	ORG $2B0EC
	callHack_r3(Trade_Portrait_Fix2)
	ORG $2AE14
	callHack_r3(Trade_Item_Usability_Fix)

	POP

	#ifdef CAPTURE_SKILL_REQUIRED
	ALIGN 4
	Capture_Usability:
	#include "Capture_Usability_Func.lyn.event"
	POIN Fill_Capture_Range_Map SkillTester
	WORD CaptureID
	#endif

	#ifndef CAPTURE_SKILL_REQUIRED
	ALIGN 4
	Capture_Usability:
	#include "Capture_Usability_Func_NoSkill.lyn.event"
	POIN Fill_Capture_Range_Map SkillTester
	WORD CaptureID
	#endif

	ALIGN 4
	Fill_Capture_Range_Map:
	#include "Fill_Capture_Range_Map.lyn.event"
	POIN Capture_Target_Check|1
	
	ALIGN 4
	Capture_Target_Check:
	#include "Capture_Target_Check.lyn.event"
	POIN SkillTester
	WORD WatchfulID
	
	ALIGN 4
	Capture_Effect_Func:
	#include "Capture_Effect_Func.lyn.event"
	
	ALIGN 4
	New_Attack_Map:
	#include "New_Attack_Map.lyn.event"
	POIN Is_Capture_Set Fill_Capture_Range_Map
	
	ALIGN 4
	New_Weapon_Select:
	#include "New_Weapon_Select.lyn.event"
	POIN Is_Capture_Set Fill_Capture_Range_Map
	
    ALIGN 4
    Show_Red_Squares:
    #include "Show_Red_Squares.lyn.event"
    POIN Is_Capture_Set 0x08016EBC
	
	ALIGN 4
	Is_Capture_Set:
	#include "Is_Capture_Set.lyn.event"
	
	ALIGN 4
	Cancel_Capture:
	#include "Cancel_Capture.lyn.event"
	
	ALIGN 4
	After_Battle_Rescue:
	#include "After_Battle_Rescue.lyn.event"
	POIN Is_Capture_Set
	
	ALIGN 4
	Trade_Target_List:
	#include "Trade_Target_List.lyn.event"

	ALIGN 4
	Preserve_Captured_Enemy:
	#include "Preserve_Captured_Enemy.lyn.event"

	ALIGN 4
	Drop_Dead_Enemy:
	#include "Drop_Dead_Enemy.lyn.event"
	
	ALIGN 4
	Trade_Captured_Enemy1:
	#include "Trade_Captured_Enemy1.lyn.event"
	ALIGN 4
	Trade_Captured_Enemy2:
	#include "Trade_Captured_Enemy2.lyn.event"
	
	ALIGN 4
	Trade_Portrait_Fix1:
	#include "Trade_Portrait_Fix1.lyn.event"
	
	ALIGN 4
	Trade_Portrait_Fix2:
	#include "Trade_Portrait_Fix2.lyn.event"

	ALIGN 4
	Trade_Item_Usability_Fix:
	#include "Trade_Item_Usability_Fix.lyn.event"

//	ALIGN 4
//	Should_Dead_Unit_Be_Cleared:
//	#include "Should_Dead_Unit_Be_Cleared.lyn.event"
	
	ALIGN 4
	StopDeathQuote:
	#include "StopDeathQuote.lyn.event"
	POIN Is_Capture_Set
	
	ALIGN 4
	GiveDropExp:
	#include "GiveDropExp.lyn.event"
	WORD GIVE_DROP_EXP			//add exp
	POIN give_drop_exp_proc

	ALIGN 4
	give_drop_exp_proc:
	PROC_CALL_ROUTINE(0x8015308|1) // LockGameLogic	//{U}
	PROC_SLEEP(5)
	PROC_JUMP(0x89A35B0) // gProc_MapAnimEnd	//{U}
	PROC_END

	ALIGN 4
	Blank_Portrait:
	#incext PortraitFormatter "blank_portrait.png"
	setMugEntry(0x1, Blank_Portrait, 3, 5, 3, 3)
	
#else
	ERROR "You're not assembling FE7 events!"
#endif

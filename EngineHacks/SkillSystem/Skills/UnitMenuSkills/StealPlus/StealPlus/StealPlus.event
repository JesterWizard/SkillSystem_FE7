// FE7 Steal / Steal+.
// IsItemStealable is 0x08016D38 (FE8's 0x08017054 is a different function).
// StealCommandUsability is 0x08022F78.

PUSH

ORG $16D38
jumpToHack(Rogue_Robbery)

// Adjacent-unit steal callback: pass target unit + slot instead of item short.
// jumpToHack is 8 bytes here; the veneer returns to $244D8 (cmp r0,#0).
ORG $244D0
jumpToHack(StealSlotCheck)

// Steal item submenu: r0 is unit+0x1E, r4 is slot*2. Veneer returns to $23118.
ORG $23110
jumpToHack(StealMenuSlotCheck)

POP

ALIGN 4
Rogue_Robbery:
#include "FE8-Rogue_Robbery.lyn.event"
POIN prConGetter
POIN SkillTester
WORD StealPlusID
WORD WatchfulID

ALIGN 4
StealSlotCheck:
SHORT 0xB500 0x1C28 0x1C31
BL(Rogue_Robbery)
SHORT 0x0600 0xBC02 0x468E 0x4B00 0x4718
POIN($244D8+1)

ALIGN 4
StealMenuSlotCheck:
SHORT 0xB500 0x381E 0x1C21 0x0849
BL(Rogue_Robbery)
SHORT 0xBC02 0x468E 0x4B00 0x4718
POIN($23118+1)

#ifdef ENABLE_STEAL_SKILL

	PUSH
	ORG $22F78
	jumpToHack(Can_Unit_Steal)
	POP

	ALIGN 4
	Can_Unit_Steal:
	#include "Can_Unit_Steal.lyn.event"
	POIN SkillTester
	WORD StealID
	WORD StealPlusID
	WORD CunningID
	WORD ALSO_USE_VANILLA_STEAL_CHECK

#endif

#ifdef ENABLE_AI_STEAL_PLUS
	// FE8 AI steal inline sites ($3DB70, $3DC0C, $3DC66) are not steal AI
	// on FE7. Enemy steal stays vanilla (items only).
#endif

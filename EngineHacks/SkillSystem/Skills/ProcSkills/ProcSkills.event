DownWithArch: //lethality if the enemy's name starts with "Arch"
#include "DownWithArch/proc_downwitharch.lyn.event"
POIN SkillTester
WORD DownWithArchID

ALIGN 4
Proc_BlackMagic:
#include "BlackMagic/proc_blackmagic.lyn.event"
POIN SkillTester
WORD BlackMagicID
POIN BlackMagicTable

//Bytes are status id, percent chance
//MAKE SURE THE PERCENTAGES SUM UP TO 100%
ALIGN 4
BlackMagicTable:
BYTE 1 25 //poison
BYTE 2 25 //silence
BYTE 3 25 //sleep
BYTE 4 25 //berserk

ALIGN 4

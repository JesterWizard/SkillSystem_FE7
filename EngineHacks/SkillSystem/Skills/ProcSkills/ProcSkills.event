Proc_Glacies:
#include "Glacies/proc_glacies.lyn.event"
POIN SkillTester
WORD GlaciesID

// Adept extra strikes: FE7 hit count lives in r5, so hook GetBattleUnitHitCount
// (0x8029114) instead of the FE8 proc-loop stack poke / 8-byte buffer write.
PUSH
ORG $29114
jumpToHack(GetBattleUnitHitCount_Adept)
POP

ALIGN 4
GetBattleUnitHitCount_Adept:
#include "Adept/get_battle_unit_hit_count.lyn.event"
POIN SkillTester
WORD AdeptID
WORD AstraID
WORD AetherID

ALIGN 4

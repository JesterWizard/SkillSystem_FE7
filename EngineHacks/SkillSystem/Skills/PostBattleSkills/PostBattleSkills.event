ALIGN 4
FailGale:
#include "FailGale/FailGale.lyn.event"
POIN SkillTester
WORD FailGaleID

PUSH //some changes to vanilla code to make everything work
ORG $1CBA0 // FE7 TryMakeCantoUnit: ability check -> TryMakeCantoCheck.
// TryMakeCantoCheck re-applies the vanilla "already cantoed / turn ended"
// guard itself and jumps straight to the leftover-movement check at $1CBCA,
// so $1CBB6 and $1CBBE keep their vanilla bytes. Nopping that guard is what
// let a unit canto again every time it finished a canto move, and the
// blanket "fail on Combat" at $1CBBE is what kept Canto+ from ever moving
// after a fight.
jumpToHack(TryMakeCantoCheck)
// Leftover movement: use the modular Mov getter instead of raw class Mov, so
// Mov-granting skills (Celerity, ...) agree with the check canto.s already
// makes. Replaces $1CBCA-$1CBD9; $1CBDA (bl CanUnitMove) is untouched.
ORG $1CBCA
SHORT 0x1C10            // mov  r0, r2       ; gActiveUnit
BL(prGotoMovGetter)
SHORT 0x7C24            // ldrb r4, [r4,#0x10] ; squares moved this turn
SHORT 0x42A0            // cmp  r0, r4
SHORT 0xDD06            // ble  $1CBE4       ; nothing left to move
SHORT 0x46C0 0x46C0
ORG $181FA //FE8 -> $18754 //this used to set state to "turn ended"
SHORT 0x46C0
ORG $2F50C //FE8 -> $323A0 //making dance not clear the galeforce flag
SHORT 0xFFBD
SHORT 0xFFFF
ORG $34DC8 //FE8 -> $39B98 //this sets 00040000 to the status bitfield thing for some reason on non-player units
SHORT 0x46C0
POP

#ifndef ACTION_MOVETARGET
#define ACTION_MOVETARGET 0x23
#define ACTION_MOVEACTIVE 0x24
#define ACTION_SWAP       0x25
#define ACTION_PUSH       0x26
#define ACTION_SWARP      0x27
#endif


ALIGN 4
CheckGaleforce: //decides if the unit should be cantoing or not
#include "Galeforce/checkgaleforce.lyn.event"

PUSH
ORG $1CC04 //FE8 -> $1D2B8 //this used to set state to "cantoing", it's just there to make sure galeforce has priority
jumpToHack(CheckGaleforce)
ORG $34E0C //FE8 -> $39BDC //this added 1 to make the ai move the next unit
POP


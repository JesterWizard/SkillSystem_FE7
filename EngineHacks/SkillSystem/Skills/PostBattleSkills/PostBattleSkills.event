#include "Extensions/PopupDefinitions.txt"

ALIGN 4
// "<unit> obtained a <item>". Article is its own component (0x0F, white)
// so the item name can be blue. 0x0F is wired in SkillScrolls.event.
DespoilPopup:
	Popup_SetSound(0x37A)		// the vanilla item-get jingle
	Popup_SetColor(0)
	Popup_UnitName
	Popup_StringId(DespoilGotText)	// " obtained "
	Popup_ItemArticle		// white "a " / "an "
	Popup_SetColor(2)
	Popup_ItemName
	Popup_Space(1)
	Popup_ItemIcon
	Popup_End

ALIGN 4
Despoil:
#include "Despoil/despoil.lyn.event"
POIN SkillTester
WORD DespoilID
POIN DespoilPopupProc
POIN DespoilPopup

// After the lyn include so CallDespoilPopup is already defined (a forward
// POIN into the blob has been 0 and crashed on CALL_2).
ALIGN 4
DespoilPopupProc:
	SHORT 0x16 0
	POIN (CallDespoilPopup|1)
	SHORT 0x00 0 0 0
//POIN DespoilEvent
//#include "Despoil/DespoilEvent.event"


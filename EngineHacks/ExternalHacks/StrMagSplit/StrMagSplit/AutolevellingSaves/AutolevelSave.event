// FE7 Mag bases / autolevel (unit+0x47)

#ifndef _FE7_
	ERROR "AutolevelSave.event requires FE7"
#endif

PUSH

	ORG 0x17958
	callHack_r3(Write_Bases_to_RAM)

	// 0x17AF2: 3 halfwords then POIN at 0x17AF8; routine returns to 0x17AFC.
	ORG 0x17AF2
	SHORT 0x4801 0x4700 0x0000
	POIN (Class_Mag_Autolevel|1)

POP

ALIGN 4
Write_Bases_to_RAM:
#incbin "WriteBasestoRAM.dmp"
POIN MagCharTable
POIN MagClassTable

ALIGN 4
Class_Mag_Autolevel:
#incbin "ClassMagAutolevel.dmp"
POIN MagClassTable
